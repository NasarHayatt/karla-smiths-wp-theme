{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1180px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "page", "name": "Page background (ivory)", "color": "#FFF9F3" },
				{ "slug": "cream", "name": "Cream (hero and alternate sections)", "color": "#FBF4EC" },
				{ "slug": "header", "name": "Header background", "color": "#FFFDF9" },
				{ "slug": "card", "name": "Card and form background", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink (body text)", "color": "#302B27" },
				{ "slug": "brown", "name": "Deep green (headings, buttons)", "color": "#2F3927" },
				{ "slug": "sage", "name": "Eyebrow label", "color": "#596248" },
				{ "slug": "muted", "name": "Muted text", "color": "#6F665F" },
				{ "slug": "line", "name": "Line and card border", "color": "#E5D9CC" },
				{ "slug": "rose", "name": "Rose beige", "color": "#F5EDEA" },
				{ "slug": "gold", "name": "Gold", "color": "#C6A56B" },
				{ "slug": "footer", "name": "Footer green", "color": "#283024" },
				{ "slug": "field", "name": "Form field border", "color": "#CFC1B4" },
				{ "slug": "numeral", "name": "Card numeral", "color": "#CDB9A8" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif (headings)",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "sans",
					"name": "Sans (body)",
					"fontFamily": "Arial, Helvetica, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.87rem" },
				{ "slug": "base", "name": "Body", "size": "1rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.42rem" },
				{ "slug": "heading-m", "name": "Heading 3", "size": "2rem" },
				{ "slug": "heading-l", "name": "Heading 2", "size": "clamp(2.3rem, 4vw, 4rem)" },
				{ "slug": "heading-xl", "name": "Heading 1", "size": "clamp(3rem, 6vw, 5rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "0"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--brown)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "700", "lineHeight": "1.05" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-xl)", "lineHeight": "1" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-l)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-m)", "lineHeight": "1.15" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brown)",
					"text": "#FFFFFF"
				},
				"border": { "radius": "999px", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--brown)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.82rem",
					"fontWeight": "700",
					"letterSpacing": "0.09em",
					"textTransform": "uppercase",
					"lineHeight": "1.65"
				},
				"spacing": { "padding": { "top": "13px", "right": "22px", "bottom": "13px", "left": "22px" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--brown)",
						"text": "#FFFFFF"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"color": { "text": "var(--wp--preset--color--brown)" },
				"typography": { "fontWeight": "700", "fontSize": "1.9rem", "lineHeight": "1.1" },
				"elements": {
					"link": { "color": { "text": "var(--wp--preset--color--brown)" } }
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.76rem",
					"fontWeight": "700",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
